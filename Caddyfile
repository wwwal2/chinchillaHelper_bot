b-bot-webhook.duckdns.org {

    handle /webhook {
        reverse_proxy be:8080
    }

    handle /logs {
        reverse_proxy be:8080 {
            flush_interval -1
        }
    }

    handle /status {
        reverse_proxy be:8080
    }

    handle /control {
        reverse_proxy be:8080
    }

    handle {
        reverse_proxy fe:80
    }
}